# ==============================================================================
# NAMI Routing Engine Demo - Environment Configuration Template
# ==============================================================================

# Enable demo bypass mode (logs in instantly as 'guest@nami.local' with 'admin' role)
# Default is true if left unset. Set to false to enforce real Firebase auth.
DEMO_AUTH_BYPASS=true

# Allowed CORS Origins (comma-separated list of web origins allowed to query API)
# Defaults to localhost and 127.0.0.1 on ports 5050, 5173, and 8000
CORS_ALLOW_ORIGINS=*

# Sentry DSN configuration (Optional, for error monitoring)
# SENTRY_DSN=
# SENTRY_FRONTEND_DSN=

# Firebase configuration (Optional, only needed if DEMO_AUTH_BYPASS is set to false)
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_PATH=
