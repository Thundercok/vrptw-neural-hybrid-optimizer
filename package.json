{
    "name": "vrptw-frontend",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint src/frontend/js",
        "format:check": "prettier --check \"src/frontend/**/*.{html,css,js}\"",
        "format": "prettier --write \"src/frontend/**/*.{html,css,js}\"",
        "dev:all": "concurrently -k -n \"backend,vite\" -c \"blue,green\" \"make dev\" \"vite --port 5050 --host 127.0.0.1\""
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.0",
        "concurrently": "^9.2.1",
        "eslint": "^8.57.0",
        "prettier": "^3.2.5",
        "vite": "^5.3.0"
    },
    "eslintConfig": {
        "env": { "browser": true, "es2022": true, "node": true },
        "extends": "eslint:recommended",
        "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
        "rules": {
            "no-unused-vars": "warn",
            "no-console": "off",
            "no-undef": "warn",
            "no-empty": "warn"
        },
        "globals": {
            "db": "readonly",
            "firebase": "readonly",
            "firebaseService": "readonly",
            "L": "readonly",
            "Chart": "readonly",
            "XLSX": "readonly",
            "firebaseAuth": "readonly"
        }
    },
    "prettier": {
        "semi": true,
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "printWidth": 120
    }
}
